<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<!--
  Quiz Battle V3 - Category + Pack Cards
  - Category Cards for main categories
  - Pack Cards are shown after category selection
  - Original Team Panels
-->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane"
            fx:controller="de.hhn.it.devtools.javafx.quizapp.controllers.QuizBattleControllerV3"
            styleClass="root-pane">

    <!-- ==================== HEADER ==================== -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="15">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane fx:id="logoIcon" styleClass="logo-icon">
                    <Label fx:id="logoLabel" text="🎯" style="-fx-font-size: 24px;"/>
                </StackPane>
                <Label text="QUIZ BATTLE" styleClass="logo-text"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="15">
                <HBox styleClass="round-counter" alignment="CENTER" spacing="8">
                    <Label text="Question" styleClass="round-label"/>
                    <Label fx:id="questionNumberLabel" text="0/0" styleClass="round-number"/>
                </HBox>

                <StackPane fx:id="timerCircle" styleClass="timer-circle">
                    <Label fx:id="timerLabel" text="--" styleClass="timer-text"/>
                </StackPane>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="statusLabel" text="Ready to start" styleClass="status-label"/>
        </HBox>
    </top>

    <!-- ==================== MAIN CONTENT ==================== -->
    <center>
        <HBox styleClass="main-content">

            <!-- LEFT TEAM PANEL - Original Style (solid color) -->
            <VBox fx:id="team1Panel" styleClass="team-panel-orange" alignment="CENTER"
                  spacing="15" HBox.hgrow="NEVER" minWidth="180" prefWidth="200">

                <StackPane styleClass="team-icon-container">
                    <Label fx:id="team1Icon" text="" style="-fx-font-size: 50px;"/>
                </StackPane>

                <Label fx:id="team1NameLabel" text="Team 1" styleClass="team-name"/>

                <HBox styleClass="score-box" alignment="CENTER">
                    <Label fx:id="team1ScoreLabel" text="0" styleClass="score-text"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox alignment="CENTER" spacing="8">
                    <Label text="Key: Q" styleClass="buzz-hint"/>
                    <Button fx:id="buzzer1Button" styleClass="buzz-button-orange" prefWidth="140" prefHeight="80">
                        <graphic>
                            <VBox alignment="CENTER" spacing="2">
                                <Label text="BUZZ" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                                <Label text="BUZZ!" styleClass="buzz-text-light"/>
                            </VBox>
                        </graphic>
                    </Button>
                </VBox>

                <padding>
                    <Insets top="20" right="15" bottom="25" left="15"/>
                </padding>
            </VBox>

            <!-- CENTER CONTENT -->
            <VBox styleClass="center-content" alignment="CENTER" spacing="20" HBox.hgrow="ALWAYS">

                <!-- ===== SETUP SCREEN ===== -->
                <VBox fx:id="setupPane" styleClass="lobby-pane" alignment="CENTER" spacing="20"
                      managed="true" visible="true">

                    <Label text="Set up game" styleClass="section-title"/>

                    <!-- Teams Setup - With Team Images -->
                    <HBox alignment="CENTER" spacing="30">
                        <VBox styleClass="team-preview-orange" alignment="CENTER" spacing="10">
                            <StackPane fx:id="team1PreviewIcon" styleClass="team-preview-icon">
                                <Label text="" style="-fx-font-size: 50px;"/>
                            </StackPane>
                            <TextField fx:id="team1NameField" text="Team 1" styleClass="team-name-input"
                                       promptText="Team 1 Name"/>
                        </VBox>

                        <StackPane styleClass="vs-badge">
                            <Label text="VS" styleClass="vs-text"/>
                        </StackPane>

                        <VBox styleClass="team-preview-blue" alignment="CENTER" spacing="10">
                            <StackPane fx:id="team2PreviewIcon" styleClass="team-preview-icon">
                                <Label text="" style="-fx-font-size: 50px;"/>
                            </StackPane>
                            <TextField fx:id="team2NameField" text="Team 2" styleClass="team-name-input"
                                       promptText="Team 2 Name"/>
                        </VBox>
                    </HBox>

                    <!-- Category Selection with Cards -->
                    <VBox spacing="15" alignment="CENTER" styleClass="category-section">
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="Choose category" styleClass="section-subtitle"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <CheckBox fx:id="randomModeCheckBox" text="Random mode"
                                      styleClass="random-checkbox"/>
                        </HBox>

                        <!-- Category Cards Row -->
                        <HBox fx:id="categoryCardsBox" alignment="CENTER" spacing="10">
                            <!-- Dynamically populated -->
                        </HBox>

                        <!-- Pack Cards Row (appears after category selection) -->
                        <VBox fx:id="packSection" alignment="CENTER" spacing="8" visible="false" managed="false">
                            <Label fx:id="packSectionLabel" text="Select theme package" styleClass="pack-section-label"/>
                            <HBox fx:id="packCardsBox" alignment="CENTER" spacing="10">
                                <!-- Dynamically populated -->
                            </HBox>
                        </VBox>

                        <!-- Selection Info -->
                        <Label fx:id="selectionInfoLabel" text="" styleClass="selection-info"/>
                    </VBox>

                    <!-- Game Settings -->
                    <HBox styleClass="settings-row" alignment="CENTER" spacing="30">
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="Number of questions:" styleClass="setting-label"/>
                            <Button text="-" styleClass="round-adjust-btn" onAction="#decreaseRounds"/>
                            <Label fx:id="roundsValue" text="5" styleClass="rounds-value"/>
                            <Button text="+" styleClass="round-adjust-btn" onAction="#increaseRounds"/>
                        </HBox>
                    </HBox>

                    <!-- Start Button -->
                    <Button fx:id="startButton" text="Start game" styleClass="start-button"/>
                </VBox>

                <!-- ===== GAME SCREEN ===== -->
                <VBox fx:id="gamePane" styleClass="game-pane" alignment="CENTER" spacing="20"
                      managed="false" visible="false">

                    <StackPane fx:id="questionCard" styleClass="question-card">
                        <VBox alignment="CENTER" spacing="15">
                            <Label fx:id="categoryBadge" text="QUIZ" styleClass="category-badge"/>
                            <Label fx:id="questionLabel" text="Question is being loaded..."
                                   styleClass="question-text" wrapText="true" textAlignment="CENTER"/>
                        </VBox>
                    </StackPane>

                    <Label fx:id="resultLabel" text="" styleClass="result-label" visible="false"/>

                    <VBox fx:id="answersBox" styleClass="answers-box" alignment="CENTER" spacing="12">
                    </VBox>

                    <HBox fx:id="textInputBox" alignment="CENTER" spacing="10" visible="false" managed="false">
                        <TextField fx:id="textAnswerField" promptText="Type answer..."
                                   prefWidth="300" styleClass="text-answer-field"/>
                        <Button fx:id="submitTextButton" text="✓ Send" styleClass="submit-text-btn"/>
                    </HBox>

                    <HBox fx:id="buzzIndicator" styleClass="buzz-indicator" alignment="CENTER" spacing="15"
                          managed="false" visible="false">
                        <Label fx:id="buzzedTeamLabel" text="TEAM" styleClass="buzzed-team-text"/>
                        <Label text="has buzzed!" styleClass="buzzed-text"/>
                    </HBox>
                </VBox>

                <!-- ===== GAME OVER SCREEN ===== -->
                <VBox fx:id="gameOverPane" styleClass="game-over-pane" alignment="CENTER" spacing="30"
                      managed="false" visible="false">
                    <Label text="WINNER" style="-fx-font-size: 40px; -fx-text-fill: gold;"/>
                    <Label text="GAME ENDED" styleClass="game-over-title"/>
                    <Label fx:id="winnerLabel" text="" styleClass="winner-text"/>

                    <HBox alignment="CENTER" spacing="50">
                        <VBox alignment="CENTER" spacing="5">
                            <Label fx:id="finalTeam1Name" text="Team 1" styleClass="final-team-name"/>
                            <Label fx:id="finalTeam1Score" text="0" styleClass="final-score-orange"/>
                        </VBox>
                        <Label text="-" style="-fx-font-size: 36px; -fx-text-fill: white;"/>
                        <VBox alignment="CENTER" spacing="5">
                            <Label fx:id="finalTeam2Name" text="Team 2" styleClass="final-team-name"/>
                            <Label fx:id="finalTeam2Score" text="0" styleClass="final-score-blue"/>
                        </VBox>
                    </HBox>

                    <Button fx:id="restartButton" text="NEW GAME" styleClass="start-button"/>
                </VBox>

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>
            </VBox>

            <!-- RIGHT TEAM PANEL - Original Style (solid color) -->
            <VBox fx:id="team2Panel" styleClass="team-panel-blue" alignment="CENTER"
                  spacing="15" HBox.hgrow="NEVER" minWidth="180" prefWidth="200">

                <StackPane styleClass="team-icon-container">
                    <Label fx:id="team2Icon" text="" style="-fx-font-size: 50px;"/>
                </StackPane>

                <Label fx:id="team2NameLabel" text="Team 2" styleClass="team-name"/>

                <HBox styleClass="score-box" alignment="CENTER">
                    <Label fx:id="team2ScoreLabel" text="0" styleClass="score-text"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox alignment="CENTER" spacing="8">
                    <Label text="Key: P" styleClass="buzz-hint"/>
                    <Button fx:id="buzzer2Button" styleClass="buzz-button-blue" prefWidth="140" prefHeight="80">
                        <graphic>
                            <VBox alignment="CENTER" spacing="2">
                                <Label text="BUZZ" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                                <Label text="BUZZ!" styleClass="buzz-text-light"/>
                            </VBox>
                        </graphic>
                    </Button>
                </VBox>

                <padding>
                    <Insets top="20" right="15" bottom="25" left="15"/>
                </padding>
            </VBox>
        </HBox>
    </center>
</BorderPane>
